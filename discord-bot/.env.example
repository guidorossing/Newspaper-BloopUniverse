# Kopieer dit bestand naar .env en vul de waarden in. NOOIT .env committen.

# Uit de Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord-rol die met de knoppen mag goed-/afkeuren
DISCORD_ADMIN_ROLE=CMS Admin

# Kanaal-id voor de dagelijkse 09:00-reminder (rechtsklik kanaal -> ID kopiëren)
DISCORD_REMINDER_CHANNEL_ID=

# CMS-koppeling: genereer het bot-token in het CMS onder Instellingen
CMS_URL=http://localhost:3000
CMS_BOT_TOKEN=
