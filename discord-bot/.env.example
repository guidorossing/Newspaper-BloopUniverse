# Copy this file to .env and fill it in, then run: npm install && npm start

# From the Discord Developer Portal (Bot -> Token)
DISCORD_TOKEN=
# Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Right-click your server -> Copy Server ID (needs Developer Mode on).
# Leave empty to register the commands globally (takes up to an hour).
DISCORD_GUILD_ID=

# Discord role that may use the approve/reject buttons
DISCORD_ADMIN_ROLE=CMS Admin
# Channel id for the 09:00 morning reminder (empty = no reminder)
DISCORD_REMINDER_CHANNEL_ID=

# Where the CMS runs, as seen from the bot
CMS_URL=https://cms.rossingtm.com
# CMS -> Settings -> "Generate bot token"
CMS_BOT_TOKEN=
