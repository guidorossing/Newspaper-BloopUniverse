{
  // Cloudflare Workers config — serves this repo as a static site.
  // The "name" must match the Worker/project name in your Cloudflare dashboard.
  "name": "bloopuniverse-insider",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
