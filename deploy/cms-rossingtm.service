# systemd-unit voor het Rossing T&M CMS
# Installatie: zie docs/deploy-vps.md
[Unit]
Description=Rossing T&M CMS
After=network.target

[Service]
Type=simple
User=rossingtm
WorkingDirectory=/opt/cms-rossingtm
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
Environment=PORT=3000
# Optioneel: vaste vault-sleutel via env i.p.v. data/vault.key
# Environment=CMS_VAULT_KEY=<64 hex tekens>

[Install]
WantedBy=multi-user.target
